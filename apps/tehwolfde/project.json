{
  "name": "tehwolfde",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/tehwolfde/src",
  "prefix": "tehw0lf",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/tehwolfde",
        "index": "apps/tehwolfde/src/index.html",
        "browser": "apps/tehwolfde/src/main.ts",
        "tsConfig": "apps/tehwolfde/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/tehwolfde/src/favicon.svg",
          "apps/tehwolfde/src/robots.txt",
          "apps/tehwolfde/src/assets"
        ],
        "styles": [
          "./node_modules/@tehw0lf/mvc/index.scss",
          "apps/tehwolfde/src/styles.scss"
        ],
        "allowedCommonJsDependencies": [
          "cartesian-product-generator",
          "@primer/octicons"
        ],
        "webWorkerTsConfig": "apps/tehwolfde/tsconfig.worker.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": true,
          "sourceMap": true,
          "extractLicenses": true,
          "namedChunks": false
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4215
      },
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "tehwolfde:build:production"
        },
        "development": {
          "buildTarget": "tehwolfde:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "tehwolfde:build"
      }
    }
  }
}
